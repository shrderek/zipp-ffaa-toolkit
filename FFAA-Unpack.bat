@echo off
setlocal
title FFAA Firmware Unpacker

set "PS1=%TEMP%\ffaa_unpack_%RANDOM%%RANDOM%.ps1"
set "B64F=%TEMP%\ffaa_unpack_%RANDOM%%RANDOM%.b64"

echo.
echo   ============================================================
echo      FFAA Firmware Unpacker  v1.2
echo      Supports Libratone OTA packages and plain ZIP archives
echo      Container: text header + offset obfuscation + ZIP
echo   ============================================================
echo.

if "%~1"=="" goto ASK

:LOOP
if "%~1"=="" goto END
call :PREP
if not exist "%PS1%" goto FAILPREP
echo   [*] %~nx1
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" "%~f1"
shift
goto LOOP

:ASK
echo   Drag a firmware zip into this window, then press Enter:
echo.
set "F="
set /p "F=  Path: "
if not defined F goto END
set "F=%F:"=%"
call :PREP
if not exist "%PS1%" goto FAILPREP
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" "%F%"
goto END

:PREP
if exist "%PS1%" goto :EOF
>"%B64F%" (
  for /f "delims=" %%a in ('findstr /b "::B64:" "%~f0"') do (
    set "L=%%a"
    call echo %%L:~6%%
  )
)
certutil -decode -f "%B64F%" "%PS1%" >nul 2>&1
del "%B64F%" >nul 2>&1
goto :EOF

:FAILPREP
echo   [X] Failed to extract the embedded script.
echo       Make sure certutil.exe is available, or run
echo       ffaa_unpack.ps1 directly with PowerShell.
goto END

:END
del "%PS1%" >nul 2>&1
if not defined FFAA_NO_PAUSE pause
endlocal

