@echo off
setlocal
title FFAA Firmware Repacker

set "PS1=%TEMP%\ffaa_pack_%RANDOM%%RANDOM%.ps1"
set "B64F=%TEMP%\ffaa_pack_%RANDOM%%RANDOM%.b64"

echo.
echo   ============================================================
echo      FFAA Firmware Repacker   v1.0
echo      folder  =^>  FFAA container
echo   ============================================================
echo.

if "%~1"=="" goto ASK

:LOOP
if "%~1"=="" goto END
call :PREP
if not exist "%PS1%" goto FAILPREP
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" "%~f1"
shift
goto LOOP

:ASK
echo   Drop the extracted firmware FOLDER into this window, then press Enter.
echo   Keep the original .zip next to the folder to preserve the real header.
echo.
set "F="
set /p "F=   Folder: "
if not defined F goto END
set "F=%F:"=%"
call :PREP
if not exist "%PS1%" goto FAILPREP
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" "%F%"
goto END

:PREP
if exist "%PS1%" goto :EOF
>"%B64F%" (
  for /f "delims=" %%a in ('findstr /b "::B64:" "%~f0"') do (
    set "L=%%a"
    call echo %%L:~6%%
  )
)
certutil -decode -f "%B64F%" "%PS1%" >nul 2>&1
del "%B64F%" >nul 2>&1
goto :EOF

:FAILPREP
echo   [X] Could not release the internal script. certutil may be blocked.
echo       Run ffaa_pack.ps1 directly instead.
goto END

:END
del "%PS1%" >nul 2>&1
if not defined FFAA_NO_PAUSE pause
endlocal

